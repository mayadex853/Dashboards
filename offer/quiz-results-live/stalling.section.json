    "wtr_stalling_results_code": {
      "hidden": false,
      "name": "Code",
      "settings": {
        "code": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Anton&family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&display=swap');\nhtml,body{background:#0d0d0f !important}\n#section-wtr_stalling_results .container,#section-wtr_stalling_results .row,#section-wtr_stalling_results [class*=col-],#section-wtr_stalling_results .block{padding:0 !important;margin:0 !important;max-width:none !important;width:100% !important;flex:0 0 100% !important}\n#section-wtr_stalling_results .sizer{padding:0 !important}\n\n.rr-root{--bp-paper:url('https://raw.githubusercontent.com/mayadex853/Dashboards/0d5fcabb6e63eccab9300613af510942bcd31e21/offer/blueprint/assets/blueprint-paper.jpg');--wtr-black:#0d0d0f;--wtr-red:#d72626;--wtr-blue-cta:#4aa7ff;--bp-blue:#1f4a71;--bp-line:rgba(244,244,244,.78);--bp-line-soft:rgba(244,244,244,.22);background:var(--wtr-black);color:#f4f4f4;font-family:'Inter',system-ui,sans-serif;overflow:hidden}\n.rr-wrap{max-width:1040px;margin:0 auto;padding:0 32px;position:relative;z-index:2}\n.rr-root p{line-height:1.7;font-size:18px;color:#c7c9cc;margin:0 0 20px;font-family:'Inter',sans-serif}\n.rr-red{color:var(--wtr-red)}\n.rr-hero-zone{position:relative;background:linear-gradient(100deg,rgba(13,13,15,.92) 0%,rgba(13,13,15,.75) 38%,rgba(13,13,15,.3) 100%),url('https://raw.githubusercontent.com/mayadex853/Dashboards/0d5fcabb6e63eccab9300613af510942bcd31e21/offer/blueprint/assets/hero-wreck-room.jpg') center right / cover no-repeat;padding:84px 0 110px}\n.rr-badge{display:inline-flex;align-items:center;gap:8px;padding:9px 18px;border:1px solid var(--wtr-red);background:rgba(215,38,38,.12);color:var(--wtr-red);font-family:'Oswald',sans-serif;font-weight:600;font-size:12px;letter-spacing:2.4px;text-transform:uppercase;margin-bottom:28px}\n.rr-badge::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--wtr-red)}\n.rr-hero-zone h1{font-family:'Anton',Impact,sans-serif;font-weight:400;font-size:58px;line-height:1.08;text-transform:uppercase;margin:0 0 30px;color:#f4f4f4;max-width:760px;letter-spacing:.3px}\n.rr-hero-zone h2{font-family:'Oswald',sans-serif;font-weight:500;font-size:19px;letter-spacing:1px;text-transform:uppercase;color:var(--wtr-red);margin:0 0 18px}\n.rr-hero-zone p{font-size:18px;max-width:640px}\n@media (max-width:760px){.rr-hero-zone h1{font-size:36px}.rr-hero-zone{padding:64px 0 90px;background:linear-gradient(180deg,rgba(13,13,15,.88),rgba(13,13,15,.94)),url('https://raw.githubusercontent.com/mayadex853/Dashboards/0d5fcabb6e63eccab9300613af510942bcd31e21/offer/blueprint/assets/hero-wreck-room.jpg') center/cover}}\n.rr-torn{position:relative;height:64px;background:var(--wtr-black);clip-path:polygon(0 0,100% 0,100% 40%,90% 72%,80% 36%,70% 68%,60% 32%,50% 72%,40% 36%,30% 68%,20% 32%,10% 72%,0 40%);margin-bottom:-1px;z-index:3;position:relative}\n.rr-blue-zone{position:relative;background:linear-gradient(180deg,rgba(11,31,48,.9),rgba(11,31,48,.95)),var(--bp-paper);background-size:auto,760px 760px;padding:10px 0 90px;overflow:hidden}\n.rr-grid-overlay{position:absolute;inset:0;pointer-events:none;z-index:0;background-image:repeating-linear-gradient(0deg,rgba(244,244,244,.045) 0 1px,transparent 1px 64px),repeating-linear-gradient(90deg,rgba(244,244,244,.045) 0 1px,transparent 1px 64px)}\n.rr-compass{position:absolute;top:36px;right:36px;width:52px;height:52px;z-index:1;opacity:.75}\n.rr-compass svg{width:100%;height:100%;stroke:var(--bp-line);fill:none;stroke-width:1.2}\n.rr-frame{position:relative;z-index:2;max-width:1040px;margin:0 auto;padding:60px 32px 10px;border:1px solid var(--bp-line-soft)}\n.rr-frame::before,.rr-frame::after{content:'';position:absolute;width:20px;height:20px;pointer-events:none}\n.rr-frame::before{top:-1px;left:-1px;border-top:1.5px solid var(--bp-line);border-left:1.5px solid var(--bp-line)}\n.rr-frame::after{bottom:-1px;right:-1px;border-bottom:1.5px solid var(--bp-line);border-right:1.5px solid var(--bp-line)}\n.rr-kicker-row{display:flex;align-items:center;gap:12px;margin-bottom:14px}\n.rr-kicker-row .rr-dash{width:28px;height:1px;background:var(--wtr-red)}\n.rr-kicker-row span{font-family:'Oswald',sans-serif;font-size:13px;letter-spacing:2px;text-transform:lowercase;color:#a9bccb;font-style:italic}\n.rr-blue-zone h2.rr-h2big{font-family:'Anton',Impact,sans-serif;font-weight:400;font-size:40px;line-height:1.15;text-transform:uppercase;color:#f0f3f6;margin:0 0 20px;letter-spacing:.3px}\n.rr-section{margin:0 0 76px}\n.rr-section:last-child{margin-bottom:0}\n.bp-sheet{position:relative;border:1.5px solid var(--bp-line-soft);box-shadow:rgba(0,0,0,.5) 0 24px 50px -24px;background:linear-gradient(180deg,rgba(31,74,113,.75),rgba(15,42,66,.85))}\n.bp-cap{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:9px 20px;border-bottom:1px solid var(--bp-line-soft);font-family:'Oswald',sans-serif}\n.bp-cap span{font-size:11px;letter-spacing:2.6px;text-transform:uppercase;color:var(--bp-line)}\n.bp-inner{padding:28px 24px 32px}\n.rr-kicker{display:block;color:#a9bccb;font-size:13px;margin-bottom:28px;font-family:'Oswald',sans-serif;letter-spacing:1.5px;text-transform:uppercase}\n.rr-grid{display:grid;grid-template-columns:110px 1fr 1fr;gap:10px}\n.rr-cell{padding:20px 18px;border:1px solid var(--bp-line-soft);background:repeating-linear-gradient(0deg,rgba(244,244,244,.035) 0 1px,transparent 1px 28px),repeating-linear-gradient(90deg,rgba(244,244,244,.035) 0 1px,transparent 1px 28px),rgba(11,31,48,.5);transition:transform .2s ease,border-color .2s ease}\n.rr-cell:not(.rr-head):not(.rr-label):hover{transform:translateY(-3px);border-color:var(--bp-line)}\n.rr-cell.rr-head{background:transparent;border:none;display:flex;align-items:center;justify-content:center;font-family:'Oswald',sans-serif;font-weight:500;font-size:11px;letter-spacing:1.8px;text-transform:uppercase;color:#a9bccb;text-align:center;padding:6px}\n.rr-cell.rr-label{background:transparent;border:none;display:flex;align-items:center;justify-content:center;font-family:'Oswald',sans-serif;font-weight:500;font-size:11px;letter-spacing:1.8px;text-transform:uppercase;color:#a9bccb;writing-mode:vertical-rl;transform:rotate(180deg);text-align:center}\n.rr-icon{width:32px;height:32px;border:1px solid var(--bp-line);background:transparent;display:flex;align-items:center;justify-content:center;margin-bottom:12px}\n.rr-icon svg{width:16px;height:16px;stroke:var(--bp-line);fill:none;stroke-width:1.5}\n.rr-cell.rr-here .rr-icon{border-color:var(--wtr-red);background:rgba(215,38,38,.15)}\n.rr-cell.rr-here .rr-icon svg{stroke:var(--wtr-red)}\n.rr-cell .rr-title{display:flex;align-items:center;gap:8px;font-family:'Oswald',sans-serif;font-size:15px;color:#f5f7f8;margin-bottom:8px;font-weight:500;text-transform:uppercase;letter-spacing:.3px}\n.rr-cell p{font-size:13.5px;line-height:1.55;margin:0;color:#aebfcc;font-family:'Inter',sans-serif}\n.rr-cell.rr-here{border-color:var(--wtr-red);box-shadow:0 0 0 1px var(--wtr-red) inset,0 12px 30px -10px rgba(215,38,38,.35)}\n.rr-cell.rr-here .rr-title{color:var(--wtr-red)}\n.rr-here-tag{display:inline-flex;align-items:center;gap:5px;margin-left:2px;font-size:9.5px;letter-spacing:1.2px;color:#0d0d0f;background:var(--wtr-red);padding:3px 9px;font-family:'Oswald',sans-serif;font-weight:600;vertical-align:middle;text-transform:uppercase}\n@media (max-width:620px){.rr-grid{grid-template-columns:60px 1fr 1fr;gap:6px}.rr-cell{padding:13px}.rr-cell .rr-title{font-size:12px;flex-wrap:wrap}.rr-cell p{font-size:11.5px}.rr-icon{width:24px;height:24px;margin-bottom:8px}.rr-icon svg{width:12px;height:12px}.rr-here-tag{display:block;margin:6px 0 0;width:fit-content}}\n.rr-segue-grid{display:grid;grid-template-columns:1fr 400px;gap:44px;align-items:center}\n.rr-segue p{font-size:18px}\n.rr-emphasis{font-family:'Oswald',sans-serif;font-size:21px;color:#f5f7f8;border-left:3px solid var(--wtr-red);padding-left:18px;margin-top:8px;margin-bottom:0;text-transform:uppercase;letter-spacing:.3px;line-height:1.4}\n@media (max-width:900px){.rr-segue-grid{grid-template-columns:1fr;gap:28px}}\n.wtr-stall-box{position:relative;width:100%;max-width:400px;margin:0;border:1px solid var(--bp-line-soft);overflow:hidden;background:rgba(5,16,27,.55);aspect-ratio:16/10}\n.wtr-sf-scene{position:relative;width:100%;height:100%}\n.wtr-sf-ground{position:absolute;left:0;right:0;bottom:16%;height:1px;background:var(--bp-line);z-index:1}\n.wtr-sf-sign{position:absolute;right:14%;bottom:16%;display:flex;flex-direction:column;align-items:center;z-index:2}\n.wtr-sf-sign-head{width:32px;height:32px;background:var(--wtr-red);clip-path:polygon(30% 0%,70% 0%,100% 30%,100% 70%,70% 100%,30% 100%,0% 70%,0% 30%);display:flex;align-items:center;justify-content:center;color:#0d0d0f;font-family:'Oswald',sans-serif;font-weight:800;font-size:8px;letter-spacing:.5px}\n.wtr-sf-sign-pole{width:2px;height:44px;background:var(--bp-line)}\n.wtr-sf-figure{position:absolute;bottom:16%;left:4%;width:24px;height:52px;z-index:5;transition:left 3s ease-in-out}\n.wtr-sf-figure.no-transition{transition:none !important}\n.wtr-sf-figure.at-sign{left:54%}\n.wtr-sf-head{position:absolute;top:0;left:50%;transform:translateX(-50%);width:12px;height:12px;border-radius:50%;border:1.5px solid var(--bp-line);background:transparent}\n.wtr-sf-body{position:absolute;top:12px;left:50%;width:2px;height:19px;background:var(--bp-line);transform:translateX(-50%)}\n.wtr-sf-arm{position:absolute;top:15px;left:50%;width:2px;height:13px;background:var(--bp-line);transform-origin:top center}\n.wtr-sf-arm.left{transform:translateX(-50%) rotate(-20deg)}\n.wtr-sf-arm.right{transform:translateX(-50%) rotate(20deg)}\n.wtr-sf-leg{position:absolute;top:31px;left:50%;width:2px;height:19px;background:var(--bp-line);transform-origin:top center}\n.wtr-sf-leg.left{transform:translateX(-50%) rotate(-12deg)}\n.wtr-sf-leg.right{transform:translateX(-50%) rotate(12deg)}\n.wtr-sf-figure.walking .wtr-sf-leg.left{animation:wtr-sf-walk-l .5s ease-in-out infinite}\n.wtr-sf-figure.walking .wtr-sf-leg.right{animation:wtr-sf-walk-r .5s ease-in-out infinite}\n.wtr-sf-figure.walking .wtr-sf-arm.left{animation:wtr-sf-walk-r .5s ease-in-out infinite}\n.wtr-sf-figure.walking .wtr-sf-arm.right{animation:wtr-sf-walk-l .5s ease-in-out infinite}\n@keyframes wtr-sf-walk-l{0%,100%{transform:translateX(-50%) rotate(-24deg)}50%{transform:translateX(-50%) rotate(16deg)}}\n@keyframes wtr-sf-walk-r{0%,100%{transform:translateX(-50%) rotate(24deg)}50%{transform:translateX(-50%) rotate(-16deg)}}\n.wtr-sf-bubble{position:absolute;bottom:62%;left:4%;transform:translate(-10%,0) scale(.8);opacity:0;transition:opacity .4s ease,transform .4s ease,left 3s ease-in-out;background:rgba(244,244,244,.95);color:#0d0d0f;font-family:'Inter',sans-serif;font-weight:700;font-size:11px;padding:7px 12px;border-radius:14px;white-space:nowrap;pointer-events:none;z-index:6}\n.wtr-sf-bubble.no-transition{transition:none !important}\n.wtr-sf-bubble:after{content:'';position:absolute;bottom:-5px;left:18px;width:10px;height:10px;background:inherit;clip-path:polygon(0 0,100% 0,0 100%);transform:rotate(-45deg)}\n.wtr-sf-bubble.show{opacity:1;transform:translate(-10%,0) scale(1)}\n.wtr-sf-bubble.at-sign{left:54%}\n.wtr-sf-label{position:absolute;top:12px;right:14px;display:flex;align-items:center;gap:8px;color:#eef2f5;font-family:'Oswald',sans-serif;font-size:10.5px;font-weight:500;letter-spacing:1.6px;text-transform:uppercase;z-index:6;text-align:right;max-width:72%}\n.wtr-sf-dot{width:7px;height:7px;border-radius:50%;background:var(--wtr-red);flex-shrink:0}\n@media (prefers-reduced-motion: reduce){.wtr-sf-figure{transition:none}.wtr-sf-figure.walking .wtr-sf-leg,.wtr-sf-figure.walking .wtr-sf-arm{animation:none}.wtr-sf-bubble{transition:none}}\n@media (max-width:900px){.wtr-stall-box{max-width:100%}}\n.rr-pitch .rr-sub{font-size:18px;max-width:640px;margin:0 0 34px}\n.rr-btn{display:inline-block;background:var(--wtr-blue-cta);color:#0d0d0f !important;font-family:'Oswald',sans-serif;font-weight:700;font-size:16px;letter-spacing:.5px;padding:17px 36px;border:none;border-radius:4px;text-decoration:none !important;text-transform:uppercase;transition:transform .15s ease,box-shadow .15s ease,background .15s ease}\n.rr-btn:hover{transform:translateY(-2px);background:#69b8ff;box-shadow:0 14px 32px -10px rgba(74,167,255,.5)}\n.rr-curriculum{max-width:760px;margin:46px 0 0;display:flex;flex-direction:column}\n.rr-lesson{display:flex;gap:18px;align-items:flex-start;padding:20px 4px;border-bottom:1px dashed var(--bp-line-soft)}\n.rr-lesson:last-child{border-bottom:none}\n.rr-lesson-num{flex-shrink:0;width:30px;height:30px;border:1px solid var(--wtr-red);color:var(--wtr-red);font-family:'Oswald',sans-serif;font-weight:600;display:flex;align-items:center;justify-content:center;font-size:13px}\n.rr-lesson-text b{display:block;font-family:'Oswald',sans-serif;font-weight:500;font-size:16px;color:#f5f7f8;margin-bottom:4px;text-transform:uppercase;letter-spacing:.2px}\n.rr-lesson-text span{font-size:14.5px;color:#aebfcc;line-height:1.5;font-family:'Inter',sans-serif}\n.rr-ascension p{max-width:680px}\n.rr-ascension .rr-final-line{font-family:'Oswald',sans-serif;color:var(--wtr-red);font-size:17px;margin-bottom:30px;text-transform:uppercase;letter-spacing:1px}\n@media (max-width:620px){.rr-blue-zone h2.rr-h2big{font-size:26px}.rr-frame{padding:40px 18px 10px}.rr-section{margin-bottom:56px}}\n\n.rr-proof-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}\n.rr-tm-card{position:relative;border:1px solid var(--bp-line-soft);background:rgba(11,31,48,.5);cursor:pointer;overflow:hidden;transition:transform .2s ease,border-color .2s ease}\n.rr-tm-card:hover{transform:translateY(-3px);border-color:var(--bp-line)}\n.rr-tm-media{position:relative;aspect-ratio:16/10;background:#000;overflow:hidden}\n.rr-tm-media img{width:100%;height:100%;object-fit:cover;display:block;opacity:.85}\n.rr-tm-play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:48px;height:48px;border-radius:50%;background:rgba(215,38,38,.92);display:flex;align-items:center;justify-content:center}\n.rr-tm-play svg{width:16px;height:16px;fill:#f4f4f4;margin-left:2px}\n.rr-tm-body{padding:18px 18px 20px}\n.rr-tm-quote{font-size:14px;color:#dfe6ea;font-family:'Inter',sans-serif;line-height:1.55;margin:0 0 12px;font-style:italic}\n.rr-tm-name{font-family:'Oswald',sans-serif;font-size:13px;color:#f5f7f8;text-transform:uppercase;letter-spacing:.6px;margin:0}\n.rr-tm-role{font-family:'Inter',sans-serif;font-size:12px;color:#8fa3b3;margin:2px 0 0}\n@media (max-width:760px){.rr-proof-grid{grid-template-columns:1fr}}\n.rr-tm-modal{position:fixed;inset:0;background:rgba(5,8,11,.92);z-index:9999;display:none;align-items:center;justify-content:center;padding:24px}\n.rr-tm-modal.open{display:flex}\n.rr-tm-modal-inner{position:relative;width:100%;max-width:720px;aspect-ratio:16/9;background:#000}\n.rr-tm-modal-inner video,.rr-tm-modal-inner iframe{width:100%;height:100%;border:none;display:block}\n.rr-tm-close{position:absolute;top:-40px;right:0;color:#f4f4f4;font-family:'Oswald',sans-serif;font-size:13px;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;background:none;border:1px solid var(--bp-line-soft);padding:8px 14px}\n</style>\n\n<div class=\"rr-root\">\n  <div class=\"rr-hero-zone\">\n    <div class=\"rr-wrap\">\n      <div class=\"rr-badge\">Your Quiz Results Are In</div>\n      <h1>You Are in the <span class=\"rr-red\">Stalling Room.</span></h1>\n      <h2>What This Means For You Right Now:</h2>\n      <p>Hey. Welcome. And I want to say something to you right at the start that most people won&rsquo;t say: You&rsquo;re not here because you lack information.</p>\n      <p>You took the quiz. You landed in Stalling. And if you&rsquo;re being honest with yourself, you already knew that before you clicked submit. You know what needs to change. You&rsquo;ve known for a while. Maybe it&rsquo;s the business model that stopped fitting two years ago. Maybe it&rsquo;s the relationship dynamic you keep saying you&rsquo;ll address when things calm down.</p>\n      <p>But Stallers aren&rsquo;t stuck because they lack awareness. You&rsquo;re stuck because you have it&mdash;and you still haven&rsquo;t moved.</p>\n      <p>The problem isn&rsquo;t knowledge. It&rsquo;s not strategy. It&rsquo;s not timing. The problem is that knowing and moving are two completely different things. And somewhere between those two, you&rsquo;ve built a very comfortable, very convincing life. Stalling isn&rsquo;t laziness. You can articulate exactly what&rsquo;s wrong with painful precision. And then you don&rsquo;t move. Because the identity you&rsquo;ve been operating from was built to keep you safe&mdash;and safety means staying where things are predictable.</p>\n    </div>\n  </div>\n  <div class=\"rr-torn\"></div>\n  <div class=\"rr-blue-zone\">\n    <div class=\"rr-grid-overlay\"></div>\n    <div class=\"rr-compass\"><svg viewBox=\"0 0 48 48\"><circle cx=\"24\" cy=\"24\" r=\"20\"/><path d=\"M24 6v6M24 36v6M6 24h6M36 24h6\"/><path d=\"M24 14l4 10-4 10-4-10z\"/><text x=\"24\" y=\"12\" font-size=\"7\" fill=\"currentColor\" stroke=\"none\" text-anchor=\"middle\">N</text></svg></div>\n    <div class=\"rr-frame\">\n      <div class=\"rr-section\">\n        <div class=\"rr-kicker-row\"><span class=\"rr-dash\"></span><span>01 &middot; the floor plan</span></div>\n        <h2 class=\"rr-h2big\">The Four Identity Rooms</h2>\n        <span class=\"rr-kicker\">Where awareness meets action</span>\n        <div class=\"rr-grid\">\n          <div class=\"rr-cell rr-head\"></div>\n          <div class=\"rr-cell rr-head\">No Action</div>\n          <div class=\"rr-cell rr-head\">Taking Action</div>\n          <div class=\"rr-cell rr-label\">Aware</div>\n          <div class=\"rr-cell rr-here\">\n            <div class=\"rr-icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 2h12M6 22h12M7 2c0 5 10 5 10 10s-10 5-10 10M17 2c0 5-10 5-10 10s10 5 10 10\"/></svg></div>\n            <span class=\"rr-title\">The Stalling Room <span class=\"rr-here-tag\">You Are Here</span></span>\n            <p>Paralyzed by analysis. You know your toxic loops inside out, but you are frozen in the &ldquo;Comfort of Almost&rdquo; to protect yourself from risk.</p>\n          </div>\n          <div class=\"rr-cell\">\n            <div class=\"rr-icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3 7h6l-5 4 2 7-6-4-6 4 2-7-5-4h6z\"/></svg></div>\n            <span class=\"rr-title\">The Rebuilding Room</span>\n            <p>Deep self-awareness paired with intentional action. However, your old architecture is still operating just below your radar.</p>\n          </div>\n          <div class=\"rr-cell rr-label\">Unaware</div>\n          <div class=\"rr-cell\">\n            <div class=\"rr-icon\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 3\"/></svg></div>\n            <span class=\"rr-title\">The Drifting Room</span>\n            <p>Operating on autopilot. You are feeling numb or coasting, totally blind to why your growth has stalled.</p>\n          </div>\n          <div class=\"rr-cell\">\n            <div class=\"rr-icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 12a9 9 0 0 1 15-6.7L21 8M21 12a9 9 0 0 1-15 6.7L3 16\"/><path d=\"M15 3v5h5M9 21v-5H4\"/></svg></div>\n            <span class=\"rr-title\">The Renovating Room</span>\n            <p>Working 80 hours a week rearranging furniture in a space that actually needs to be demolished.</p>\n          </div>\n        </div>\n      </div>\n      <div class=\"rr-section rr-segue\">\n        <div class=\"rr-kicker-row\"><span class=\"rr-dash\"></span><span>02 &middot; the open loop</span></div>\n        <h2 class=\"rr-h2big\">Welcome To The Comfort Of Almost</h2>\n        <div class=\"rr-segue-grid\">\n          <div>\n            <p>Almost is a very specific place. It&rsquo;s close enough to feel like you&rsquo;re moving, but not close enough that anything actually changes. You research the decision thoroughly. You talk about it with people you trust. You make the plan, revise the plan, refine the plan. Almost feels productive. That&rsquo;s what makes it so powerful.</p>\n            <p>The identity you built needs Almost to exist because Almost means you&rsquo;re still in control. You haven&rsquo;t failed yet. You haven&rsquo;t been exposed. But safe is slowly costing you everything you actually want.</p>\n            <p class=\"rr-emphasis\">Awareness without execution is just self-torture. You cannot analyze your way out of a room you are frozen in. You have to locate the load-bearing walls and make a real move.</p>\n          </div>\n          <div class=\"bp-sheet\">\n            <div class=\"bp-cap\"><span>Section B&ndash;B</span><span>The Stall</span></div>\n            <div class=\"bp-inner\"><div id=\"rr-anim-slot\"></div></div>\n          </div>\n        </div>\n      </div>\n      <div class=\"rr-section rr-pitch\">\n        <div class=\"rr-kicker-row\"><span class=\"rr-dash\"></span><span>03 &middot; the blueprint</span></div>\n        <h2 class=\"rr-h2big\">Stop Hiding Behind Your Awareness. <span class=\"rr-red\">Discover What You Are Actually Protecting.</span></h2>\n        <p class=\"rr-sub\">A raw, 5-part intensive for hyper-aware, frozen high-achievers to trace their resistance, map their blind spots, and locate the &ldquo;Last Layer&rdquo; keeping them safe but stuck.</p>\n        <a class=\"rr-btn\" href=\"https://www.wrecktheroom.com/offers/UFGxioGz/checkout\">Melt the Resistance &amp; Join the Intensive &ndash; Just $47</a>\n        <div class=\"rr-curriculum\">\n          <div class=\"rr-lesson\"><div class=\"rr-lesson-num\">1</div><div class=\"rr-lesson-text\"><b>You Already Know</b><span>Featuring the Stall Inventory to explicitly name the three structural changes you&rsquo;ve avoided acting on for over six months.</span></div></div>\n          <div class=\"rr-lesson\"><div class=\"rr-lesson-num\">2</div><div class=\"rr-lesson-text\"><b>The Comfort of Almost</b><span>Featuring the Almost Audit to isolate the fake progress, endless research, and preparation loops keeping you in control.</span></div></div>\n          <div class=\"rr-lesson\"><div class=\"rr-lesson-num\">3</div><div class=\"rr-lesson-text\"><b>What You&rsquo;re Actually Protecting</b><span>Featuring the Protection Inventory to identify the identity, relationships, or fear of failure you are secretly risking if you move.</span></div></div>\n          <div class=\"rr-lesson\"><div class=\"rr-lesson-num\">4</div><div class=\"rr-lesson-text\"><b>The First Real Move</b><span>Identifying the singular, high-friction step you&rsquo;ve been avoiding putting on the list&mdash;and how to cross the line.</span></div></div>\n          <div class=\"rr-lesson\"><div class=\"rr-lesson-num\">5</div><div class=\"rr-lesson-text\"><b>The Unlocked Architecture</b><span>Isolating the data of your room so your mental bottlenecks can naturally dissolve.</span></div></div>\n        </div>\n      </div>\n            <div class=\"rr-section rr-proof\">\n        <div class=\"rr-kicker-row\"><span class=\"rr-dash\"></span><span>04 &middot; the proof</span></div>\n        <h2 class=\"rr-h2big\">Real Architects. Real Rebuilds.</h2>\n        <span class=\"rr-kicker\">People who stopped renovating and started wrecking</span>\n        <div class=\"rr-proof-grid\">\n          <div class=\"rr-tm-card\" data-video-type=\"mp4\" data-video-src=\"https://cdn.jsdelivr.net/gh/mayadex853/Dashboards@e0253179f8d3b318762b7f51d270a164a09fa63b/wtr-homepage/media/sharn-clark-testimonial.mp4\">\n            <div class=\"rr-tm-media\"><img src=\"https://cdn.jsdelivr.net/gh/mayadex853/Dashboards@29498cc27c2ee8d517e81e35e46071434b208343/wtr-homepage/media/sharn-clark-poster.jpg\" alt=\"Shar'n C.\"><div class=\"rr-tm-play\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 3l16 9-16 9z\"/></svg></div></div>\n            <div class=\"rr-tm-body\"><p class=\"rr-tm-quote\">&ldquo;I&rsquo;ve done programs with Mel Robbins&hellip; and I feel that Wreck the Room is more beneficial.&rdquo;</p><p class=\"rr-tm-name\">Shar&rsquo;n C.</p><p class=\"rr-tm-role\">Small Business Owner</p></div>\n          </div>\n          <div class=\"rr-tm-card\" data-video-type=\"vimeo\" data-video-src=\"https://player.vimeo.com/video/1183442453?autoplay=1\">\n            <div class=\"rr-tm-media\"><img src=\"https://i.vimeocdn.com/video/2146308089-b43c720e144a206be4a8cafcec94672b0e0c9628a5dd43cce7b0c2b373d60259-d_640\" alt=\"Christy B.\"><div class=\"rr-tm-play\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 3l16 9-16 9z\"/></svg></div></div>\n            <div class=\"rr-tm-body\"><p class=\"rr-tm-quote\">&ldquo;Jody&rsquo;s authenticity reflected back to me exactly where I want to be.&rdquo;</p><p class=\"rr-tm-name\">Christy B.</p><p class=\"rr-tm-role\">Realtor &amp; Business Owner</p></div>\n          </div>\n          <div class=\"rr-tm-card\" data-video-type=\"vimeo\" data-video-src=\"https://player.vimeo.com/video/1183442331?autoplay=1\">\n            <div class=\"rr-tm-media\"><img src=\"https://i.vimeocdn.com/video/2146307512-9e5b02f9328fd95dc5d80a9dc62f277ee32edd65b3f8e85d807281ddafd24df0-d_640\" alt=\"Jeremy D.\"><div class=\"rr-tm-play\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 3l16 9-16 9z\"/></svg></div></div>\n            <div class=\"rr-tm-body\"><p class=\"rr-tm-quote\">&ldquo;Jody&rsquo;s framework really helped me name where I&rsquo;m at in that process.&rdquo;</p><p class=\"rr-tm-name\">Jeremy D.</p><p class=\"rr-tm-role\">Small Business Owner</p></div>\n          </div>\n        </div>\n      </div>\n      <div class=\"rr-section rr-ascension\" style=\"margin-bottom:10px\">\n        <div class=\"rr-kicker-row\"><span class=\"rr-dash\"></span><span>05 &middot; the demolition permit</span></div>\n        <h2 class=\"rr-h2big\">Put Down The Blueprint. The Demolition Happens Next.</h2>\n        <p>This program is not another piece of information to consume. It is a precise architectural audit to snap you out of analysis paralysis.</p>\n        <p>Once you complete these 5 lessons and map out your internal walls, you will have undeniable clarity on exactly what subconscious architecture has been keeping you frozen. This program handles the &ldquo;Wreckognize&rdquo; phase. For those who complete the 5 days, face their Protection Inventory, and are ready to stop planning and start actively Wrecking the Old Architecture and Wrock the New Room, you will have the exclusive opportunity to apply for a private 1-on-1 strategy call with me to look over your map.</p>\n        <p class=\"rr-final-line\">But first, let&rsquo;s stop researching, step across the line, and find the walls.</p>\n        <a class=\"rr-btn\" href=\"https://www.wrecktheroom.com/offers/UFGxioGz/checkout\">Get Instant Access to the Intensive ($47)</a>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>(function(){\nfunction initScene(box){\n  box.innerHTML='<div class=\"wtr-sf-scene\"><div class=\"wtr-sf-ground\"></div><div class=\"wtr-sf-sign\"><div class=\"wtr-sf-sign-head\">STOP</div><div class=\"wtr-sf-sign-pole\"></div></div><div class=\"wtr-sf-figure\" id=\"wtr-sf-figure\"><div class=\"wtr-sf-head\"></div><div class=\"wtr-sf-body\"></div><div class=\"wtr-sf-arm left\"></div><div class=\"wtr-sf-arm right\"></div><div class=\"wtr-sf-leg left\"></div><div class=\"wtr-sf-leg right\"></div></div><div class=\"wtr-sf-bubble\" id=\"wtr-sf-bubble\"><span id=\"wtr-sf-bubble-text\"></span></div><div class=\"wtr-sf-label\"><span class=\"wtr-sf-dot\"></span><span class=\"wtr-sf-label-text\">Walking Toward The Line</span></div></div>';\n  var fig=box.querySelector('#wtr-sf-figure');\n  var bubble=box.querySelector('#wtr-sf-bubble');\n  var bubbleText=box.querySelector('#wtr-sf-bubble-text');\n  var labelText=box.querySelector('.wtr-sf-label-text');\n  var thoughts=['Research first','Needs to be perfect','Not the right time','What if it fails','One more plan'];\n  function runCycle(){\n    fig.classList.add('no-transition');bubble.classList.add('no-transition');\n    fig.classList.remove('walking','at-sign');bubble.classList.remove('at-sign','show');\n    void fig.offsetWidth;\n    fig.classList.remove('no-transition');bubble.classList.remove('no-transition');\n    labelText.textContent='Walking Toward The Line';\n    fig.classList.add('walking');\n    setTimeout(function(){fig.classList.add('at-sign');bubble.classList.add('at-sign');},50);\n    setTimeout(function(){fig.classList.remove('walking');labelText.textContent='Standing At The Sign';cycleThoughts(0);},3100);\n  }\n  function cycleThoughts(i){\n    if(i>=thoughts.length){labelText.textContent='Still Frozen At The Edge';bubble.classList.remove('show');setTimeout(runCycle,1200);return;}\n    bubbleText.textContent=thoughts[i];bubble.classList.add('show');labelText.textContent='Still Thinking It Through';\n    setTimeout(function(){bubble.classList.remove('show');setTimeout(function(){cycleThoughts(i+1);},300);},1300);\n  }\n  runCycle();\n}\nvar slot=document.getElementById('rr-anim-slot');\nif(slot && !document.getElementById('wtr-sf-box')){\n  var box=document.createElement('div');box.id='wtr-sf-box';box.className='wtr-stall-box';slot.appendChild(box);initScene(box);\n}\n})();</script>\n<div class=\"rr-tm-modal\" id=\"rr-tm-modal\"><div class=\"rr-tm-modal-inner\" id=\"rr-tm-modal-inner\"></div><button class=\"rr-tm-close\" id=\"rr-tm-close\">Close &times;</button></div>\n<script>(function(){\n  var modal=document.getElementById('rr-tm-modal');\n  var inner=document.getElementById('rr-tm-modal-inner');\n  var closeBtn=document.getElementById('rr-tm-close');\n  if(!modal) return;\n  document.querySelectorAll('.rr-tm-card').forEach(function(card){\n    card.addEventListener('click',function(){\n      var type=card.getAttribute('data-video-type');\n      var src=card.getAttribute('data-video-src');\n      if(type==='mp4'){\n        inner.innerHTML='<video src=\"'+src+'\" controls autoplay playsinline></video>';\n      } else {\n        inner.innerHTML='<iframe src=\"'+src+'\" allow=\"autoplay; fullscreen\" allowfullscreen></iframe>';\n      }\n      modal.classList.add('open');\n    });\n  });\n  function closeModal(){modal.classList.remove('open');inner.innerHTML='';}\n  if(closeBtn) closeBtn.addEventListener('click',closeModal);\n  modal.addEventListener('click',function(e){if(e.target===modal)closeModal();});\n})();</script>",
