    "wtr_renovating_results_code": {
      "hidden": false,
      "name": "Code",
      "settings": {
        "code": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Anton&family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&display=swap');\nhtml,body{background:#0d0d0f !important}\n#section-wtr_renovating_results .container,#section-wtr_renovating_results .row,#section-wtr_renovating_results [class*=col-],#section-wtr_renovating_results .block{padding:0 !important;margin:0 !important;max-width:none !important;width:100% !important;flex:0 0 100% !important}\n#section-wtr_renovating_results .sizer{padding:0 !important}\n\n.rr-root{\n  --bp-paper:url('https://raw.githubusercontent.com/mayadex853/Dashboards/0d5fcabb6e63eccab9300613af510942bcd31e21/offer/blueprint/assets/blueprint-paper.jpg');\n  --wtr-black:#0d0d0f;\n  --wtr-red:#d72626;\n  --wtr-blue-cta:#4aa7ff;\n  --bp-blue:#1f4a71;\n  --bp-line:rgba(244,244,244,.78);\n  --bp-line-soft:rgba(244,244,244,.22);\n  background:var(--wtr-black);\n  color:#f4f4f4;\n  font-family:'Inter',system-ui,sans-serif;\n  overflow:hidden;\n}\n.rr-wrap{max-width:1040px;margin:0 auto;padding:0 32px;position:relative;z-index:2}\n.rr-root p{line-height:1.7;font-size:18px;color:#c7c9cc;margin:0 0 20px;font-family:'Inter',sans-serif}\n.rr-red{color:var(--wtr-red)}\n\n.rr-hero-zone{\n  position:relative;\n  background:\n    linear-gradient(100deg,rgba(13,13,15,.92) 0%,rgba(13,13,15,.75) 38%,rgba(13,13,15,.3) 100%),\n    url('https://raw.githubusercontent.com/mayadex853/Dashboards/0d5fcabb6e63eccab9300613af510942bcd31e21/offer/blueprint/assets/hero-wreck-room.jpg') center right / cover no-repeat;\n  padding:84px 0 110px;\n}\n.rr-badge{display:inline-flex;align-items:center;gap:8px;padding:9px 18px;border:1px solid var(--wtr-red);background:rgba(215,38,38,.12);color:var(--wtr-red);font-family:'Oswald',sans-serif;font-weight:600;font-size:12px;letter-spacing:2.4px;text-transform:uppercase;margin-bottom:28px}\n.rr-badge::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--wtr-red)}\n.rr-hero-zone h1{font-family:'Anton',Impact,sans-serif;font-weight:400;font-size:58px;line-height:1.08;text-transform:uppercase;margin:0 0 30px;color:#f4f4f4;max-width:760px;letter-spacing:.3px}\n.rr-hero-zone h2{font-family:'Oswald',sans-serif;font-weight:500;font-size:19px;letter-spacing:1px;text-transform:uppercase;color:var(--wtr-red);margin:0 0 18px}\n.rr-hero-zone p{font-size:18px;max-width:640px}\n@media (max-width:760px){.rr-hero-zone h1{font-size:36px}.rr-hero-zone{padding:64px 0 90px;background:linear-gradient(180deg,rgba(13,13,15,.88),rgba(13,13,15,.94)),url('https://raw.githubusercontent.com/mayadex853/Dashboards/0d5fcabb6e63eccab9300613af510942bcd31e21/offer/blueprint/assets/hero-wreck-room.jpg') center/cover}}\n\n.rr-torn{position:relative;height:64px;background:var(--wtr-black);\n  clip-path:polygon(0 0,100% 0,100% 40%,90% 72%,80% 36%,70% 68%,60% 32%,50% 72%,40% 36%,30% 68%,20% 32%,10% 72%,0 40%);\n  margin-bottom:-1px;z-index:3;position:relative}\n\n.rr-blue-zone{\n  position:relative;\n  background:\n    linear-gradient(180deg,rgba(11,31,48,.9),rgba(11,31,48,.95)),\n    var(--bp-paper);\n  background-size:auto,760px 760px;\n  padding:10px 0 90px;\n  overflow:hidden;\n}\n.rr-grid-overlay{position:absolute;inset:0;pointer-events:none;z-index:0;\n  background-image:\n    repeating-linear-gradient(0deg,rgba(244,244,244,.045) 0 1px,transparent 1px 64px),\n    repeating-linear-gradient(90deg,rgba(244,244,244,.045) 0 1px,transparent 1px 64px);\n}\n.rr-compass{position:absolute;top:36px;right:36px;width:52px;height:52px;z-index:1;opacity:.75}\n.rr-compass svg{width:100%;height:100%;stroke:var(--bp-line);fill:none;stroke-width:1.2}\n.rr-frame{position:relative;z-index:2;max-width:1040px;margin:0 auto;padding:60px 32px 10px;border:1px solid var(--bp-line-soft)}\n.rr-frame::before,.rr-frame::after{content:'';position:absolute;width:20px;height:20px;pointer-events:none}\n.rr-frame::before{top:-1px;left:-1px;border-top:1.5px solid var(--bp-line);border-left:1.5px solid var(--bp-line)}\n.rr-frame::after{bottom:-1px;right:-1px;border-bottom:1.5px solid var(--bp-line);border-right:1.5px solid var(--bp-line)}\n\n.rr-kicker-row{display:flex;align-items:center;gap:12px;margin-bottom:14px}\n.rr-kicker-row .rr-dash{width:28px;height:1px;background:var(--wtr-red)}\n.rr-kicker-row span{font-family:'Oswald',sans-serif;font-size:13px;letter-spacing:2px;text-transform:lowercase;color:#a9bccb;font-style:italic}\n.rr-blue-zone h2.rr-h2big{font-family:'Anton',Impact,sans-serif;font-weight:400;font-size:40px;line-height:1.15;text-transform:uppercase;color:#f0f3f6;margin:0 0 20px;letter-spacing:.3px}\n.rr-section{margin:0 0 76px}\n.rr-section:last-child{margin-bottom:0}\n\n.bp-sheet{position:relative;border:1.5px solid var(--bp-line-soft);box-shadow:rgba(0,0,0,.5) 0 24px 50px -24px;background:linear-gradient(180deg,rgba(31,74,113,.75),rgba(15,42,66,.85))}\n.bp-cap{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:9px 20px;border-bottom:1px solid var(--bp-line-soft);font-family:'Oswald',sans-serif}\n.bp-cap span{font-size:11px;letter-spacing:2.6px;text-transform:uppercase;color:var(--bp-line)}\n.bp-inner{padding:28px 24px 32px}\n\n.rr-kicker{display:block;color:#a9bccb;font-size:13px;margin-bottom:28px;font-family:'Oswald',sans-serif;letter-spacing:1.5px;text-transform:uppercase}\n.rr-grid{display:grid;grid-template-columns:110px 1fr 1fr;gap:10px}\n.rr-cell{padding:20px 18px;border:1px solid var(--bp-line-soft);background:repeating-linear-gradient(0deg,rgba(244,244,244,.035) 0 1px,transparent 1px 28px),repeating-linear-gradient(90deg,rgba(244,244,244,.035) 0 1px,transparent 1px 28px),rgba(11,31,48,.5);transition:transform .2s ease,border-color .2s ease}\n.rr-cell:not(.rr-head):not(.rr-label):hover{transform:translateY(-3px);border-color:var(--bp-line)}\n.rr-cell.rr-head{background:transparent;border:none;display:flex;align-items:center;justify-content:center;font-family:'Oswald',sans-serif;font-weight:500;font-size:11px;letter-spacing:1.8px;text-transform:uppercase;color:#a9bccb;text-align:center;padding:6px}\n.rr-cell.rr-label{background:transparent;border:none;display:flex;align-items:center;justify-content:center;font-family:'Oswald',sans-serif;font-weight:500;font-size:11px;letter-spacing:1.8px;text-transform:uppercase;color:#a9bccb;writing-mode:vertical-rl;transform:rotate(180deg);text-align:center}\n.rr-icon{width:32px;height:32px;border:1px solid var(--bp-line);background:transparent;display:flex;align-items:center;justify-content:center;margin-bottom:12px}\n.rr-icon svg{width:16px;height:16px;stroke:var(--bp-line);fill:none;stroke-width:1.5}\n.rr-cell.rr-here .rr-icon{border-color:var(--wtr-red);background:rgba(215,38,38,.15)}\n.rr-cell.rr-here .rr-icon svg{stroke:var(--wtr-red)}\n.rr-cell .rr-title{display:flex;align-items:center;gap:8px;font-family:'Oswald',sans-serif;font-size:15px;color:#f5f7f8;margin-bottom:8px;font-weight:500;text-transform:uppercase;letter-spacing:.3px}\n.rr-cell p{font-size:13.5px;line-height:1.55;margin:0;color:#aebfcc;font-family:'Inter',sans-serif}\n.rr-cell.rr-here{border-color:var(--wtr-red);box-shadow:0 0 0 1px var(--wtr-red) inset,0 12px 30px -10px rgba(215,38,38,.35)}\n.rr-cell.rr-here .rr-title{color:var(--wtr-red)}\n.rr-here-tag{display:inline-flex;align-items:center;gap:5px;margin-left:2px;font-size:9.5px;letter-spacing:1.2px;color:#0d0d0f;background:var(--wtr-red);padding:3px 9px;font-family:'Oswald',sans-serif;font-weight:600;vertical-align:middle;text-transform:uppercase}\n@media (max-width:620px){\n  .rr-grid{grid-template-columns:60px 1fr 1fr;gap:6px}\n  .rr-cell{padding:13px}\n  .rr-cell .rr-title{font-size:12px;flex-wrap:wrap}\n  .rr-cell p{font-size:11.5px}\n  .rr-icon{width:24px;height:24px;margin-bottom:8px}\n  .rr-icon svg{width:12px;height:12px}\n  .rr-here-tag{display:block;margin:6px 0 0;width:fit-content}\n}\n\n.rr-segue-grid{display:grid;grid-template-columns:1fr 400px;gap:44px;align-items:center}\n.rr-segue p{font-size:18px}\n.rr-emphasis{font-family:'Oswald',sans-serif;font-size:21px;color:#f5f7f8;border-left:3px solid var(--wtr-red);padding-left:18px;margin-top:8px;margin-bottom:0;text-transform:uppercase;letter-spacing:.3px;line-height:1.4}\n@media (max-width:900px){.rr-segue-grid{grid-template-columns:1fr;gap:28px}}\n\n.wtr-reno-box{position:relative;width:100%;max-width:400px;margin:0;border:1px solid var(--bp-line-soft);overflow:hidden;background:rgba(5,16,27,.55);aspect-ratio:16/10}\n.wtr-reno-ground{position:absolute;left:0;right:0;bottom:16%;height:1px;background:var(--bp-line);z-index:1}\n.wtr-reno-panel{position:absolute;bottom:16%;left:58%;width:50px;height:110px;background:rgba(244,244,244,.04);border:1px solid var(--bp-line-soft);border-radius:2px;overflow:hidden;z-index:2}\n.wtr-reno-crack-svg{position:absolute;inset:0;width:100%;height:100%;z-index:1}\n.wtr-reno-crack-svg.front{z-index:3}\n.wtr-reno-crack-path{fill:none;stroke:rgba(0,0,0,.55);stroke-width:2;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:130;transition:stroke-dashoffset 1.3s ease}\n.wtr-reno-crack-path.no-transition{transition:none !important}\n.wtr-reno-paint{position:absolute;left:0;right:0;bottom:0;height:0%;z-index:2;background:rgba(244,244,244,.5);transition:height 1.6s ease-in-out}\n.wtr-reno-paint.no-transition{transition:none !important}\n.wtr-rf-figure{position:absolute;bottom:16%;left:4%;width:32px;height:58px;z-index:5;transition:left 2.4s ease-in-out}\n.wtr-rf-figure.no-transition{transition:none !important}\n.wtr-rf-head{position:absolute;top:0;left:50%;width:13px;height:13px;border-radius:50%;border:1.5px solid var(--bp-line);background:transparent;transform:translateX(-50%)}\n.wtr-rf-body{position:absolute;top:13px;left:50%;width:2px;height:21px;background:var(--bp-line);transform:translateX(-50%)}\n.wtr-rf-arm{position:absolute;top:15px;left:50%;width:2px;height:15px;background:var(--bp-line);transform-origin:top center;transform:rotate(8deg)}\n.wtr-rf-roller-handle-ext{position:absolute;top:100%;left:50%;width:2px;height:9px;background:var(--bp-line);transform:translateX(-50%)}\n.wtr-rf-roller-drum{position:absolute;top:calc(100% + 9px);left:50%;width:14px;height:5px;border-radius:2px;background:var(--bp-line);transform:translateX(-50%)}\n.wtr-rf-leg{position:absolute;top:34px;width:2px;height:21px;background:var(--bp-line);transform-origin:top center}\n.wtr-rf-leg.l{left:calc(50% - 3px)}\n.wtr-rf-leg.r{left:calc(50% + 3px)}\n@keyframes wtr-rf-walk-l{0%,100%{transform:rotate(22deg)}50%{transform:rotate(-22deg)}}\n@keyframes wtr-rf-walk-r{0%,100%{transform:rotate(-22deg)}50%{transform:rotate(22deg)}}\n.wtr-rf-figure.walking .wtr-rf-leg.l{animation:wtr-rf-walk-l .42s linear infinite}\n.wtr-rf-figure.walking .wtr-rf-leg.r{animation:wtr-rf-walk-r .42s linear infinite}\n@keyframes wtr-rf-paint-swipe{0%,100%{transform:rotate(-150deg)}50%{transform:rotate(-168deg)}}\n.wtr-rf-figure.painting .wtr-rf-arm{animation:wtr-rf-paint-swipe .5s ease-in-out infinite}\n@keyframes wtr-rf-scratch{0%,100%{transform:rotate(130deg)}50%{transform:rotate(148deg)}}\n.wtr-rf-figure.confused .wtr-rf-arm{animation:wtr-rf-scratch .5s ease-in-out infinite}\n.wtr-reno-label{position:absolute;top:12px;right:14px;display:flex;align-items:center;gap:8px;color:#eef2f5;font-family:'Oswald',sans-serif;font-size:10.5px;font-weight:500;letter-spacing:1.6px;text-transform:uppercase;z-index:6;text-align:right;max-width:72%}\n.wtr-reno-dot{width:7px;height:7px;border-radius:50%;background:var(--wtr-red);flex-shrink:0}\n@media (prefers-reduced-motion: reduce){.wtr-reno-paint,.wtr-rf-figure,.wtr-rf-leg,.wtr-rf-arm,.wtr-reno-crack-path{transition:none !important;animation:none !important}}\n@media (max-width:900px){.wtr-reno-box{max-width:100%}}\n\n.rr-pitch .rr-sub{font-size:18px;max-width:640px;margin:0 0 34px}\n.rr-btn{display:inline-block;background:var(--wtr-blue-cta);color:#0d0d0f !important;font-family:'Oswald',sans-serif;font-weight:700;font-size:16px;letter-spacing:.5px;padding:17px 36px;border:none;border-radius:4px;text-decoration:none !important;text-transform:uppercase;transition:transform .15s ease,box-shadow .15s ease,background .15s ease}\n.rr-btn:hover{transform:translateY(-2px);background:#69b8ff;box-shadow:0 14px 32px -10px rgba(74,167,255,.5)}\n.rr-curriculum{max-width:760px;margin:46px 0 0;display:flex;flex-direction:column}\n.rr-lesson{display:flex;gap:18px;align-items:flex-start;padding:20px 4px;border-bottom:1px dashed var(--bp-line-soft)}\n.rr-lesson:last-child{border-bottom:none}\n.rr-lesson-num{flex-shrink:0;width:30px;height:30px;border:1px solid var(--wtr-red);color:var(--wtr-red);font-family:'Oswald',sans-serif;font-weight:600;display:flex;align-items:center;justify-content:center;font-size:13px}\n.rr-lesson-text b{display:block;font-family:'Oswald',sans-serif;font-weight:500;font-size:16px;color:#f5f7f8;margin-bottom:4px;text-transform:uppercase;letter-spacing:.2px}\n.rr-lesson-text span{font-size:14.5px;color:#aebfcc;line-height:1.5;font-family:'Inter',sans-serif}\n\n.rr-ascension p{max-width:680px}\n.rr-ascension .rr-final-line{font-family:'Oswald',sans-serif;color:var(--wtr-red);font-size:17px;margin-bottom:30px;text-transform:uppercase;letter-spacing:1px}\n\n@media (max-width:620px){\n  .rr-blue-zone h2.rr-h2big{font-size:26px}\n  .rr-frame{padding:40px 18px 10px}\n  .rr-section{margin-bottom:56px}\n}\n\n.rr-proof-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}\n.rr-tm-card{position:relative;border:1px solid var(--bp-line-soft);background:rgba(11,31,48,.5);cursor:pointer;overflow:hidden;transition:transform .2s ease,border-color .2s ease}\n.rr-tm-card:hover{transform:translateY(-3px);border-color:var(--bp-line)}\n.rr-tm-media{position:relative;aspect-ratio:16/10;background:#000;overflow:hidden}\n.rr-tm-media img{width:100%;height:100%;object-fit:cover;display:block;opacity:.85}\n.rr-tm-play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:48px;height:48px;border-radius:50%;background:rgba(215,38,38,.92);display:flex;align-items:center;justify-content:center}\n.rr-tm-play svg{width:16px;height:16px;fill:#f4f4f4;margin-left:2px}\n.rr-tm-body{padding:18px 18px 20px}\n.rr-tm-quote{font-size:14px;color:#dfe6ea;font-family:'Inter',sans-serif;line-height:1.55;margin:0 0 12px;font-style:italic}\n.rr-tm-name{font-family:'Oswald',sans-serif;font-size:13px;color:#f5f7f8;text-transform:uppercase;letter-spacing:.6px;margin:0}\n.rr-tm-role{font-family:'Inter',sans-serif;font-size:12px;color:#8fa3b3;margin:2px 0 0}\n@media (max-width:760px){.rr-proof-grid{grid-template-columns:1fr}}\n.rr-tm-modal{position:fixed;inset:0;background:rgba(5,8,11,.92);z-index:9999;display:none;align-items:center;justify-content:center;padding:24px}\n.rr-tm-modal.open{display:flex}\n.rr-tm-modal-inner{position:relative;width:100%;max-width:720px;aspect-ratio:16/9;background:#000}\n.rr-tm-modal-inner video,.rr-tm-modal-inner iframe{width:100%;height:100%;border:none;display:block}\n.rr-tm-close{position:absolute;top:-40px;right:0;color:#f4f4f4;font-family:'Oswald',sans-serif;font-size:13px;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;background:none;border:1px solid var(--bp-line-soft);padding:8px 14px}\n</style>\n\n<div class=\"rr-root\">\n\n  <div class=\"rr-hero-zone\">\n    <div class=\"rr-wrap\">\n      <div class=\"rr-badge\">Your Quiz Results Are In</div>\n      <h1>You Are in the <span class=\"rr-red\">Renovating Room.</span></h1>\n      <h2>What This Means For You Right Now:</h2>\n      <p>Hey. Welcome. First, I want to acknowledge something right at the start. You&rsquo;re not here because you gave up. You&rsquo;re not here because you stopped trying. You&rsquo;re here because you&rsquo;ve been trying&mdash;consistently, seriously, with massive effort and real financial investment&mdash;and something still isn&rsquo;t working the way it should.</p>\n      <p>You&rsquo;ve probably already done more work on yourself than most people ever will. Therapy. Coaching. Books. Retreats. Morning routines. Journaling. Breathwork. You have real insight. You are genuinely more self-aware than most people you know.</p>\n      <p>But you landed in the Renovating Room for a reason: you are caught in the &ldquo;Renovation Trap.&rdquo;</p>\n      <p>Renovation is what happens when you can see that something&rsquo;s wrong with the house and you commit to fixing it. New paint. New furniture. Better lighting. It looks different. It feels different for a while. And then six months later, you&rsquo;re standing in the same house with the same feeling &mdash; hitting the same ceiling, repeating the same loops in your relationships, your business, and your inner life.</p>\n      <p>That&rsquo;s not a failure of effort. That&rsquo;s what happens when you renovate a room that needs to be wrecked. Renovation works on everything except the foundation &mdash; the identity that was built before you had any say in the matter.</p>\n    </div>\n  </div>\n\n  <div class=\"rr-torn\"></div>\n\n  <div class=\"rr-blue-zone\">\n    <div class=\"rr-grid-overlay\"></div>\n    <div class=\"rr-compass\"><svg viewBox=\"0 0 48 48\"><circle cx=\"24\" cy=\"24\" r=\"20\"/><path d=\"M24 6v6M24 36v6M6 24h6M36 24h6\"/><path d=\"M24 14l4 10-4 10-4-10z\"/><text x=\"24\" y=\"12\" font-size=\"7\" fill=\"currentColor\" stroke=\"none\" text-anchor=\"middle\">N</text></svg></div>\n\n    <div class=\"rr-frame\">\n\n      <div class=\"rr-section\">\n        <div class=\"rr-kicker-row\"><span class=\"rr-dash\"></span><span>01 &middot; the floor plan</span></div>\n        <h2 class=\"rr-h2big\">The Four Identity Rooms</h2>\n        <span class=\"rr-kicker\">Where awareness meets action</span>\n        <div class=\"rr-grid\">\n          <div class=\"rr-cell rr-head\"></div>\n          <div class=\"rr-cell rr-head\">No Action</div>\n          <div class=\"rr-cell rr-head\">Taking Action</div>\n\n          <div class=\"rr-cell rr-label\">Aware</div>\n          <div class=\"rr-cell\">\n            <div class=\"rr-icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 2h12M6 22h12M7 2c0 5 10 5 10 10s-10 5-10 10M17 2c0 5-10 5-10 10s10 5 10 10\"/></svg></div>\n            <span class=\"rr-title\">The Stalling Room</span>\n            <p>Paralyzed by analysis. You know your toxic loops inside out, but you are frozen and taking zero risks.</p>\n          </div>\n          <div class=\"rr-cell\">\n            <div class=\"rr-icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3 7h6l-5 4 2 7-6-4-6 4 2-7-5-4h6z\"/></svg></div>\n            <span class=\"rr-title\">The Rebuilding Room</span>\n            <p>Deep self-awareness paired with intentional action. However, your old architecture is still operating just below your radar.</p>\n          </div>\n\n          <div class=\"rr-cell rr-label\">Unaware</div>\n          <div class=\"rr-cell\">\n            <div class=\"rr-icon\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 3\"/></svg></div>\n            <span class=\"rr-title\">The Drifting Room</span>\n            <p>Operating on autopilot. You are feeling numb or coasting, totally blind to why your growth has stalled.</p>\n          </div>\n          <div class=\"rr-cell rr-here\">\n            <div class=\"rr-icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 12a9 9 0 0 1 15-6.7L21 8M21 12a9 9 0 0 1-15 6.7L3 16\"/><path d=\"M15 3v5h5M9 21v-5H4\"/></svg></div>\n            <span class=\"rr-title\">The Renovating Room <span class=\"rr-here-tag\">You Are Here</span></span>\n            <p>Working 80 hours a week rearranging furniture in a space that actually needs to be demolished. You are using high-volume hustle and self-help to escape your deepest patterns.</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"rr-section rr-segue\">\n        <div class=\"rr-kicker-row\"><span class=\"rr-dash\"></span><span>02 &middot; the crack in the wall</span></div>\n        <h2 class=\"rr-h2big\">Why The Crack Keeps Coming Back</h2>\n        <div class=\"rr-segue-grid\">\n          <div>\n            <p>The renovation gives you something incredibly important: it gives you the feeling of movement without requiring you to leave the room.</p>\n            <p>Think about it this way. You can repaint a wall that&rsquo;s cracking as many times as you want. You can use better paint, hire a better painter, choose a better color. The wall will look good for a while. And then the crack comes back. Because the crack isn&rsquo;t a paint problem. It&rsquo;s a foundation problem. The ground underneath is shifting and the wall is just showing you where.</p>\n            <p>The people pleasing, the overworking, the emotional distance, the self-sabotage right before the breakthrough &mdash; these aren&rsquo;t bad habits. They&rsquo;re structural features of the room you&rsquo;re in.</p>\n            <p class=\"rr-emphasis\">At some point the renovation has to end and the wrecking has to begin. But you cannot wreck a room until you know exactly where the load-bearing walls are.</p>\n          </div>\n          <div class=\"bp-sheet\">\n            <div class=\"bp-cap\"><span>Section B&ndash;B</span><span>The Renovation</span></div>\n            <div class=\"bp-inner\">\n              <div id=\"rr-anim-slot\"></div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"rr-section rr-pitch\">\n        <div class=\"rr-kicker-row\"><span class=\"rr-dash\"></span><span>03 &middot; the blueprint</span></div>\n        <h2 class=\"rr-h2big\">Stop Trying To Renovate A Room That Needs To Be Wrecked. <span class=\"rr-red\">Expose The Foundation Capping Your Success.</span></h2>\n        <p class=\"rr-sub\">A raw, 5-part intensive for exhausted high-achievers to map their patterns, run a structural audit on their life, and locate the &ldquo;Last Layer&rdquo; running quietly beneath the grind.</p>\n        <a class=\"rr-btn\" href=\"https://www.wrecktheroom.com/offers/RujeXGKk/checkout\">Break the Renovation Trap &amp; Join the Intensive &ndash; Just $67</a>\n\n        <div class=\"rr-curriculum\">\n          <div class=\"rr-lesson\">\n            <div class=\"rr-lesson-num\">1</div>\n            <div class=\"rr-lesson-text\"><b>The Renovation Trap</b><span>Featuring the Renovation Inventory to honestly assess whether the underlying patterns your past self-help work was meant to fix are still running.</span></div>\n          </div>\n          <div class=\"rr-lesson\">\n            <div class=\"rr-lesson-num\">2</div>\n            <div class=\"rr-lesson-text\"><b>What&rsquo;s Actually Underneath</b><span>Featuring the Pattern Map to trace your overworking, people-pleasing, or control loops back to the earliest room they appeared in.</span></div>\n          </div>\n          <div class=\"rr-lesson\">\n            <div class=\"rr-lesson-num\">3</div>\n            <div class=\"rr-lesson-text\"><b>The Cost of the Renovation</b><span>Featuring the True Cost Audit to calculate exactly what working on yourself has cost you in time, money, and opportunity cost just to stay in the same room.</span></div>\n          </div>\n          <div class=\"rr-lesson\">\n            <div class=\"rr-lesson-num\">4</div>\n            <div class=\"rr-lesson-text\"><b>Where Renovation Ends</b><span>Finding the line where you stop asking &ldquo;how do I change this behavior&rdquo; and start asking &ldquo;what decision created this identity.&rdquo;</span></div>\n          </div>\n          <div class=\"rr-lesson\">\n            <div class=\"rr-lesson-num\">5</div>\n            <div class=\"rr-lesson-text\"><b>The Structural Architecture</b><span>Isolating the data of your foundation so your bottlenecks can naturally dissolve.</span></div>\n          </div>\n        </div>\n      </div>\n\n            <div class=\"rr-section rr-proof\">\n        <div class=\"rr-kicker-row\"><span class=\"rr-dash\"></span><span>04 &middot; the proof</span></div>\n        <h2 class=\"rr-h2big\">Real Architects. Real Rebuilds.</h2>\n        <span class=\"rr-kicker\">People who stopped renovating and started wrecking</span>\n        <div class=\"rr-proof-grid\">\n          <div class=\"rr-tm-card\" data-video-type=\"mp4\" data-video-src=\"https://cdn.jsdelivr.net/gh/mayadex853/Dashboards@e0253179f8d3b318762b7f51d270a164a09fa63b/wtr-homepage/media/sharn-clark-testimonial.mp4\">\n            <div class=\"rr-tm-media\"><img src=\"https://cdn.jsdelivr.net/gh/mayadex853/Dashboards@29498cc27c2ee8d517e81e35e46071434b208343/wtr-homepage/media/sharn-clark-poster.jpg\" alt=\"Shar'n C.\"><div class=\"rr-tm-play\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 3l16 9-16 9z\"/></svg></div></div>\n            <div class=\"rr-tm-body\"><p class=\"rr-tm-quote\">&ldquo;I&rsquo;ve done programs with Mel Robbins&hellip; and I feel that Wreck the Room is more beneficial.&rdquo;</p><p class=\"rr-tm-name\">Shar&rsquo;n C.</p><p class=\"rr-tm-role\">Small Business Owner</p></div>\n          </div>\n          <div class=\"rr-tm-card\" data-video-type=\"vimeo\" data-video-src=\"https://player.vimeo.com/video/1183442453?autoplay=1\">\n            <div class=\"rr-tm-media\"><img src=\"https://i.vimeocdn.com/video/2146308089-b43c720e144a206be4a8cafcec94672b0e0c9628a5dd43cce7b0c2b373d60259-d_640\" alt=\"Christy B.\"><div class=\"rr-tm-play\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 3l16 9-16 9z\"/></svg></div></div>\n            <div class=\"rr-tm-body\"><p class=\"rr-tm-quote\">&ldquo;Jody&rsquo;s authenticity reflected back to me exactly where I want to be.&rdquo;</p><p class=\"rr-tm-name\">Christy B.</p><p class=\"rr-tm-role\">Realtor &amp; Business Owner</p></div>\n          </div>\n          <div class=\"rr-tm-card\" data-video-type=\"vimeo\" data-video-src=\"https://player.vimeo.com/video/1183442331?autoplay=1\">\n            <div class=\"rr-tm-media\"><img src=\"https://i.vimeocdn.com/video/2146307512-9e5b02f9328fd95dc5d80a9dc62f277ee32edd65b3f8e85d807281ddafd24df0-d_640\" alt=\"Jeremy D.\"><div class=\"rr-tm-play\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 3l16 9-16 9z\"/></svg></div></div>\n            <div class=\"rr-tm-body\"><p class=\"rr-tm-quote\">&ldquo;Jody&rsquo;s framework really helped me name where I&rsquo;m at in that process.&rdquo;</p><p class=\"rr-tm-name\">Jeremy D.</p><p class=\"rr-tm-role\">Small Business Owner</p></div>\n          </div>\n        </div>\n      </div>\n      <div class=\"rr-section rr-ascension\" style=\"margin-bottom:10px\">\n        <div class=\"rr-kicker-row\"><span class=\"rr-dash\"></span><span>05 &middot; the demolition permit</span></div>\n        <h2 class=\"rr-h2big\">The Blueprint Is Just $67. The Demolition Happens Next.</h2>\n        <p>This program is not another piece of self-help optimization. It is a precise architectural audit.</p>\n        <p>Once you complete these 5 lessons and map out your foundation using the workbooks, you will have undeniable clarity on exactly what is holding you back. This program handles the &ldquo;Wreckognize&rdquo; phase. For those who finish the 5 days, face their True Cost Audit, and are ready to cross the line to actively Wreck the Old Architecture and Wrock the New Room, you will have the exclusive opportunity to apply for a private 1-on-1 strategy call with me to map out your execution plan.</p>\n        <p class=\"rr-final-line\">But first, let&rsquo;s stop rearranging the furniture and find the walls.</p>\n        <a class=\"rr-btn\" href=\"https://www.wrecktheroom.com/offers/RujeXGKk/checkout\">Get Instant Access to the Intensive ($67)</a>\n      </div>\n\n    </div>\n  </div>\n\n</div>\n\n<script>(function(){\nfunction initScene(box){\n  box.innerHTML='<div class=\"wtr-reno-ground\"></div><div class=\"wtr-reno-panel\"><svg class=\"wtr-reno-crack-svg\" viewBox=\"0 0 54 120\" preserveAspectRatio=\"none\"><path class=\"wtr-reno-crack-path\" d=\"M30,6 L20,24 L32,40 L18,58 L30,78 L16,96 L26,114\"/></svg><div class=\"wtr-reno-paint\"></div></div><div class=\"wtr-rf-figure\"><div class=\"wtr-rf-head\"></div><div class=\"wtr-rf-body\"></div><div class=\"wtr-rf-arm\"><div class=\"wtr-rf-roller-handle-ext\"></div><div class=\"wtr-rf-roller-drum\"></div></div><div class=\"wtr-rf-leg l\"></div><div class=\"wtr-rf-leg r\"></div></div><div class=\"wtr-reno-label\"><span class=\"wtr-reno-dot\"></span><span class=\"wtr-reno-label-text\">The Same Crack Keeps Returning</span></div>';\n  var svg=box.querySelector('.wtr-reno-crack-svg');\n  var path=box.querySelector('.wtr-reno-crack-path');\n  var paint=box.querySelector('.wtr-reno-paint');\n  var figure=box.querySelector('.wtr-rf-figure');\n  var labelText=box.querySelector('.wtr-reno-label-text');\n  function runCycle(){\n    figure.classList.add('no-transition');\n    paint.classList.add('no-transition');\n    path.classList.add('no-transition');\n    figure.classList.remove('walking','painting','confused');\n    svg.classList.remove('front');\n    figure.style.left='4%';\n    paint.style.height='0%';\n    path.style.strokeDashoffset='0';\n    void figure.offsetWidth;\n    figure.classList.remove('no-transition');\n    paint.classList.remove('no-transition');\n    path.classList.remove('no-transition');\n    labelText.textContent='The Same Crack Keeps Returning';\n    setTimeout(function(){figure.classList.add('walking');figure.style.left='50%';},300);\n    setTimeout(function(){figure.classList.remove('walking');figure.classList.add('painting');paint.style.height='100%';labelText.textContent='So You Paint Over It';},2900);\n    setTimeout(function(){figure.classList.remove('painting');},4700);\n    setTimeout(function(){path.classList.add('no-transition');path.style.strokeDashoffset='130';svg.classList.add('front');void path.offsetWidth;path.classList.remove('no-transition');path.style.strokeDashoffset='0';labelText.textContent='Yet It Returns Again';},5700);\n    setTimeout(function(){figure.classList.add('confused');labelText.textContent='Why Is That?';},7100);\n    setTimeout(function(){runCycle();},8700);\n  }\n  runCycle();\n}\nvar slot=document.getElementById('rr-anim-slot');\nif(slot && !document.getElementById('wtr-reno-box')){\n  var box=document.createElement('div');\n  box.id='wtr-reno-box';\n  box.className='wtr-reno-box';\n  slot.appendChild(box);\n  initScene(box);\n}\n})();</script>\n<div class=\"rr-tm-modal\" id=\"rr-tm-modal\"><div class=\"rr-tm-modal-inner\" id=\"rr-tm-modal-inner\"></div><button class=\"rr-tm-close\" id=\"rr-tm-close\">Close &times;</button></div>\n<script>(function(){\n  var modal=document.getElementById('rr-tm-modal');\n  var inner=document.getElementById('rr-tm-modal-inner');\n  var closeBtn=document.getElementById('rr-tm-close');\n  if(!modal) return;\n  document.querySelectorAll('.rr-tm-card').forEach(function(card){\n    card.addEventListener('click',function(){\n      var type=card.getAttribute('data-video-type');\n      var src=card.getAttribute('data-video-src');\n      if(type==='mp4'){\n        inner.innerHTML='<video src=\"'+src+'\" controls autoplay playsinline></video>';\n      } else {\n        inner.innerHTML='<iframe src=\"'+src+'\" allow=\"autoplay; fullscreen\" allowfullscreen></iframe>';\n      }\n      modal.classList.add('open');\n    });\n  });\n  function closeModal(){modal.classList.remove('open');inner.innerHTML='';}\n  if(closeBtn) closeBtn.addEventListener('click',closeModal);\n  modal.addEventListener('click',function(e){if(e.target===modal)closeModal();});\n})();</script>",
