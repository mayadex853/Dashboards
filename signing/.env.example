# ---- App ----
# Public URL of the deployed app (used in email links)
APP_URL=https://sign.hdmusicnow.com
# Password for the admin dashboard (you)
ADMIN_PASSWORD=change-me-to-something-long
# Random string, 32+ chars, used to sign the login cookie (run: openssl rand -hex 32)
SESSION_SECRET=

# ---- Supabase (Project Settings > API) ----
# Leave blank to run in local mode (data stored in ./.data, for testing only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Microsoft 365 email via Microsoft Graph ----
# Azure Portal > App registrations > New. API permission: Microsoft Graph > Application > Mail.Send (grant admin consent)
# Leave blank to skip emailing (signing links are still shown in the dashboard to copy).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MAIL_FROM=jody@hdmusicnow.com
MAIL_FROM_NAME=Jody Friedman
